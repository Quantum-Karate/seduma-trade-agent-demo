{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generic-decision.schema.json",
  "title": "Generic practice decision file",
  "description": "Decisions for the Seduma Trade practice demo. The demo does not pick or recommend trades. It only simulates fills for decisions already in the file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "side", "size", "rationale"],
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "description": "Ticker, such as AAPL."
          },
          "side": {
            "enum": ["BUY", "SELL", "HOLD"]
          },
          "size": {
            "type": "number",
            "minimum": 0,
            "description": "Share quantity. HOLD must be 0."
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "description": "Passed through from the agent file. This demo does not judge it."
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD. The simulator uses the newest close on or before this date. Omit it to use the latest close in the price file."
          }
        }
      }
    }
  }
}
